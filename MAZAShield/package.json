{
  "name": "mazalab",
  "version": "0.1.1",
  "private": true,
  "type": "module",
  "description": "MAZALab Risk Intelligence platform foundation",
  "license": "UNLICENSED",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "changelog": "standard-version --release-as patch --skip.commit --skip.tag",
